<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_book_tree" model="ir.ui.view">
        <field name="name">simple.book.tree</field>
        <field name="model">simple.book</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="author"/>
                <field name="published_date"/>
                <field name="price"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_book_form" model="ir.ui.view">
        <field name="name">book.form</field>
        <field name="model">simple.book</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="author"/>
                        <field name="published_date"/>
                        <field name="price"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action to open the views -->
    <record id="action_book" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">simple.book</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_book_tree"/>
    </record>

    <!-- Menu items -->
    <menuitem id="menu_library" name="Library" sequence="1"/>
    <menuitem id="menu_books" name="Books" parent="menu_library" action="action_book" sequence="2"/>
</odoo>

