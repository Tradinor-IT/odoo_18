<odoo>
	<data noupdate="1">
		<!-- Allow users to access only their assigned pricelists -->
		<record id="rule_pricelist_user" model="ir.rule">
			<field name="name">Pricelist User Access</field>
			<field name="model_id" ref="product.model_product_pricelist"/>
			<field name="domain_force">[('allowed_user_ids', 'in', [user.id])]</field>
			<field name="groups" eval="[(4, ref('base.group_user'))]"/>
		</record>
	</data>
</odoo>
