<odoo>
	<record id="view_pricelist_form_inherit" model="ir.ui.view">
		<field name="name">pricelist.form.inherit</field>
		<field name="model">product.pricelist</field>
		<field name="inherit_id" ref="product.view_pricelist_form"/>
		<field name="arch" type="xml">
			<xpath expr="//sheet" position="inside">
				<group>
					<field name="allowed_user_ids" widget="many2many_tags"/>
				</group>
			</xpath>
		</field>
	</record>
</odoo>
